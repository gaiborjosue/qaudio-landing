# Copy to .env.local and fill in. Never commit real secret values.

# Supabase project "qaudio" (public values; safe for the browser).
NEXT_PUBLIC_SUPABASE_URL=https://kemumhpxapfadqsytudt.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only secret key (Dashboard → Project Settings → API Keys → Secret
# keys). Used only by trusted server code and scripts, such as the one-time
# news import. Never prefix it with NEXT_PUBLIC_ or paste it into chat.
SUPABASE_SECRET_KEY=

# Server-only OpenRouter key for the admin agent's models and Jev routing
# (agent/lib/models.ts), plus Instagram story designs (lib/admin/story-images.ts).
# https://openrouter.ai/settings/keys. Never prefix it with NEXT_PUBLIC_.
OPENROUTER_API_KEY=

# Optional ownership tokens from Search Console / Bing Webmaster Tools.
# Public verification metadata, not API keys. DNS verification needs no token.
# Keep existing ownership records when replacing the old website.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Exact "true" opts Terra and Sol into the local ChatGPT subscription in dev.
# Windows startup discovers the installed Codex desktop CLI for Eve's PATH.
# Reuses its ChatGPT login. False/unset and production keep OpenRouter.
# Muse Ember, Jev routing, and story images still use OPENROUTER_API_KEY.
DEBUG_DEV_MODE=false

# Server-only Groq key for voice input (Whisper Large v3, English output).
# https://console.groq.com/keys. Never prefix it with NEXT_PUBLIC_.
GROQ_API_KEY=

# Server-only Tavily key for the Products tab's Prefill with Tune, which reads
# a manufacturer's product page with Tavily Extract (advanced depth).
# https://app.tavily.com. Optional: without it, Prefill says it isn't set up.
# Never prefix it with NEXT_PUBLIC_.
TAVILY_API_KEY=

# Server-only Supermemory key for the admin agent's long-term memory
# (agent/memory/supermemory.ts). https://console.supermemory.ai/keys. Optional:
# without it, memory quietly does nothing. Never prefix it with NEXT_PUBLIC_.
SUPERMEMORY_API_KEY=

# Optional server-only origin for agent → Next cache refreshes after saves.
# Defaults to https://$VERCEL_URL on Vercel and http://localhost:3000 locally.
# Set for a different Next dev port or a self-hosted website; include no path.
# The agent's PORT belongs to Eve, so it isn't used for this callback.
SITE_ORIGIN=

# Optional server-only chat namespace, shared by Next and the agent service.
# Defaults isolate local PCs, preview branches, and production automatically.
# Set a distinct value (such as sandbox) for a separate self-hosted environment.
ADMIN_CHAT_ENVIRONMENT=

# Server-only Zernio API key and the profile shared by this site's admins.
# Connect Instagram and Google Business in that profile at https://zernio.com. Zernio manages OAuth
# and social tokens; the app never receives them. The site checks the
# connections, and the admin agent uses those services, so set
# both for the agent's service too. Never use NEXT_PUBLIC_.
ZERNIO_API_KEY=
ZERNIO_PROFILE_ID=
# Google Business live writes are off by default. True enables approved changes
# in development and production; admin checks and approval cards still apply.
ZERNIO_GOOGLE_BUSINESS_WRITES_ENABLED=false

# Optional comma-separated hostnames (no scheme/port) for Next dev tunnels.
DEV_ALLOWED_ORIGINS=
